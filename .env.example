# Copy to .env and adjust. Never commit .env.

# API
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL (docker compose maps it to host port 5433 to avoid clashing with a local Postgres)
DATABASE_URL=postgres://lumni:lumni@localhost:5433/lumni
TEST_DATABASE_URL=postgres://lumni:lumni@localhost:5433/lumni_test

# Email (Mailpit catches everything; UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="Lumni Coworking <reservas@lumni.local>"
# Demo only: make the first N send attempts fail to show retries
EMAIL_FAIL_FIRST_N=0

# AI assistant (Part 2.2)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

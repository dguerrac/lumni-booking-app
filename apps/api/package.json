{
  "name": "@lumni/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx --env-file=../../.env src/server.ts",
    "db:migrate": "tsx --env-file=../../.env src/db/run-migrations.ts",
    "db:seed": "tsx --env-file=../../.env src/db/run-seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@lumni/shared": "*",
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "kysely": "^0.27.5",
    "luxon": "^3.5.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "vitest": "^3.0.0"
  }
}
